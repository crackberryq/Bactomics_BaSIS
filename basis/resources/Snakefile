# One public workflow entry point. Administrative targets are explicit and do
# not update resources during an ordinary analysis invocation.
MODE = config.get("workflow_mode", "setup" if config.get("schema") == "basis-environment-setup-plan-v1" else "analysis")
if MODE == "setup":
    include: "rules/setup.smk"
elif MODE == "resources":
    include: "rules/resources.smk"
elif MODE == "analysis":
    include: "rules/analysis.smk"
else:
    raise ValueError("Unknown BaSIS workflow mode: " + str(MODE))
