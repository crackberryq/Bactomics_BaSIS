import os
import sys
from pathlib import Path

from basis.config import ALL_MODULES
from basis.sample_policy import module_decision

PLAN = config
ROOT = PLAN["outdir"]
SAMPLES = [s["sample_id"] for s in PLAN["samples"]]
MODULES = ALL_MODULES
PLAN_PATH = str(Path(ROOT) / "provenance" / "plans" / (PLAN["plan_hash"] + ".json"))
PYTHON = sys.executable
RUN_ID = os.environ.get("BASIS_SCHEDULER_RUN_ID", PLAN["plan_hash"])
if not RUN_ID or Path(RUN_ID).name != RUN_ID or RUN_ID in {".", ".."}:
    raise ValueError("Invalid scheduler run identifier")
RECEIPTS = str(Path(ROOT) / "provenance" / "scheduler" / RUN_ID)

# Every module writes an execution record, including disabled/withheld modules.
# Native failures are recorded as data by _worker; infrastructure failures are
# scheduler failures. The launcher always writes the consolidated report after
# this DAG has settled and preserves incomplete upstream evidence explicitly.
# Snakemake removes declared outputs when rerunning a job. Receipts, rather
# than result.json files, are therefore its outputs: BaSIS retains ownership
# of result records and can verify/reuse their content-based native caches.
rule all:
    input:
        expand(RECEIPTS + "/{sample}/{module}.json", sample=SAMPLES, module=MODULES),
        expand(RECEIPTS + "/{sample}/deepsafe.json", sample=SAMPLES)

rule module:
    input:
        plan=PLAN_PATH
    output:
        RECEIPTS + "/{sample}/{module}.json"
    wildcard_constraints:
        module="|".join(MODULES)
    threads:
        lambda wc: min(int(PLAN["config"]["modules"][wc.module].get("threads", 1)), int(PLAN["config"]["execution"]["cores"])) if module_decision(PLAN, wc.sample, wc.module)["action"] == "run" else 1
    resources:
        mem_mb=lambda wc: int(PLAN["config"]["modules"][wc.module].get("memory_mb", 4000)) if module_decision(PLAN, wc.sample, wc.module)["action"] == "run" else 1,
        gpu=lambda wc: int(PLAN["config"]["modules"][wc.module].get("gpus", 0)) if module_decision(PLAN, wc.sample, wc.module)["action"] == "run" else 0
    params:
        plan=PLAN_PATH,
        python=PYTHON,
        force="--force" if os.environ.get("BASIS_FORCE") == "1" else ""
    shell:
        "{params.python:q} -m basis _worker --plan {params.plan:q} --sample {wildcards.sample:q} --module {wildcards.module:q} --receipt {output:q} {params.force}"

rule deep:
    input:
        records=lambda wc: expand(RECEIPTS + "/{sample}/{module}.json", sample=[wc.sample], module=MODULES),
        plan=PLAN_PATH
    output:
        RECEIPTS + "/{sample}/deepsafe.json"
    threads:
        min(int(PLAN["config"]["deep"].get("threads", 1)), int(PLAN["config"]["execution"]["cores"])) if PLAN["options"]["deep"] else 1
    resources:
        mem_mb=int(PLAN["config"]["deep"].get("memory_mb", 8000)) if PLAN["options"]["deep"] else 1
    params:
        plan=PLAN_PATH,
        python=PYTHON,
        receipt_root=RECEIPTS,
        force="--force" if os.environ.get("BASIS_FORCE") == "1" else ""
    shell:
        "{params.python:q} -m basis _worker --plan {params.plan:q} --sample {wildcards.sample:q} --module deepsafe --receipt {output:q} --upstream-receipts {params.receipt_root:q} {params.force}"
