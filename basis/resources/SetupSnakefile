from pathlib import Path

PLAN = config
DIRECTORY = PLAN["directory"]
NAMES = [entry["name"] for entry in PLAN["environments"]]
PLAN_PATH = str(Path(DIRECTORY) / "plan.json")
PYTHON = PLAN["python"]

rule all:
    input:
        PLAN["summary_path"]

rule environment:
    output:
        DIRECTORY + "/environments/{environment}.json"
    wildcard_constraints:
        environment="|".join(NAMES)
    threads: 1
    params:
        python=PYTHON,
        plan=PLAN_PATH
    shell:
        "{params.python:q} -m basis.environment_workflow worker --plan {params.plan:q} --environment {wildcards.environment:q}"

rule summary:
    input:
        expand(DIRECTORY + "/environments/{environment}.json", environment=NAMES)
    output:
        PLAN["summary_path"]
    params:
        python=PYTHON,
        plan=PLAN_PATH
    shell:
        "{params.python:q} -m basis.environment_workflow summary --plan {params.plan:q}"
